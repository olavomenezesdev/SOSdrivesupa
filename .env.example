SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Set to an HTTP(S) URL allowed by Supabase Auth for email confirmation links.
# SUPABASE_EMAIL_REDIRECT_URL=https://your-domain.example/login

# Required only for local PostgreSQL migration administration.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Never expose this key to the browser. Payment persistence, webhook updates,
# and review submission use it only in the trusted Python backend.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# Asaas sandbox API. Never expose this key in frontend code or logs.
ASAAS_API_KEY=<sandbox-api-key>
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=<webhook-secret>
# Public HTTPS origin forwarding to the backend (port 8000); update when the tunnel changes.
ASAAS_CHECKOUT_RETURN_URL=https://your-public-backend.example
# Browser origin for the Reflex frontend after Asaas redirects; use your deployed frontend URL in production.
ASAAS_CHECKOUT_FRONTEND_URL=http://localhost:3000

ASAAS_API_KEY=SUA_NOVA_CHAVE_API
ASAAS_WEBHOOK_TOKEN=SEU_NOVO_TOKEN_WEBHOOK
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Local testing only: set both values to enable backend-only payment simulation.
# APP_ENV=development
# PAYMENT_MODE=mock
